# Variables de entorno para build del frontend.
#
# DEV: copiá este archivo a .env.local y rellená los valores.
# PROD: definí los mismos nombres en GitHub Actions como Secrets
#       (Settings → Secrets and variables → Actions).

# URL pública del proyecto Supabase
VITE_SUPABASE_URL=https://iprvxvsqpvsbvqbnfvly.supabase.co

# Clave anon (PUBLICA — seguridad viene de RLS, no de la key)
VITE_SUPABASE_ANON_KEY=<tu-anon-key-aqui>

# Opcional: durante la migración, dejar el backend FastAPI activo para
# llamadas que aún no migramos. Vacío = solo Supabase.
VITE_LEGACY_BACKEND_URL=http://127.0.0.1:8765

# Base path para GitHub Pages (debe terminar en /)
VITE_BASE_PATH=/restauranteia-live/